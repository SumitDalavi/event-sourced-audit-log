# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: event-sourced-audit-log
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - Embedded SQLite append-only log.
#
# TIER 2 / TIER 3: PRODUCTION POSTGRESQL / KAFKA AUDIT TRAIL
# - Supply PostgreSQL connection string with immutable audit tables.

DATABASE_URL=postgresql://user:pass@localhost:5432/audit_db
PORT=3000
